# Server-only values. Copy to .env locally; never use a NEXT_PUBLIC_ prefix.

# The exact origin the browser uses (sessions are only issued for it).
AUTH_URL=http://127.0.0.1:5173

# The one owner account. Created on first sign-in with this password; change it in the app afterwards.
OWNER_EMAIL=contact@the1core.com
OWNER_PASSWORD=

# Invitations are e-mailed from this Gmail address using a Google "App password"
# (Google account → Security → 2-Step Verification → App passwords). Leave empty to hand the
# temporary password over yourself: it is then shown on the Team page.
GMAIL_USER=contact@the1core.com
GMAIL_APP_PASSWORD=

# Supabase Postgres. Leave DATABASE_URL empty locally to use the embedded Postgres in .data/pglite.
# DATABASE_URL: the *transaction* pooler (port 6543) — what the app uses at runtime.
# DIRECT_URL:   the session pooler / direct connection (port 5432) — what `pnpm db:migrate` uses.
DATABASE_URL=
DIRECT_URL=

# Vercel Cron calls /api/flow/sweep with this bearer token (32+ chars). Vercel injects it when set in the project.
CRON_SECRET=

# Plan éditorial → Facebook & Instagram (README → "Publication"). The scheduled run
# /api/editorial/publish-due uses CRON_SECRET above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=editorial-media
META_PUBLISH_TOKEN=
META_STUDIO_FACEBOOK_PAGE_ID=
META_STUDIO_INSTAGRAM_ID=

# WhatsApp Business (Meta Cloud API): a client with a WhatsApp number gets a message each time a
# deliverable is sent for their approval. Leave empty to disable. The template must be approved in
# WhatsApp Manager first — see README → "WhatsApp" for the exact text.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
# Optional: the « new message » template — the client hears on WhatsApp when the studio writes in a task's chat.
WHATSAPP_COMMENT_TEMPLATE=

# AI with Groq (captions, titles, corrections, the floating assistant): a key from console.groq.com →
# API Keys. Leave empty to hide the AI buttons and the assistant.
GROQ_API_KEY=
# Optional: other Groq models (text, and the one that reads pictures).
GROQ_MODEL=
GROQ_VISION_MODEL=
# The assistant « One » on Google Gemini (aistudio.google.com → API keys): streamed answers, actions on
# tasks, memory. Optional model override (default gemini-flash-latest, then gemini-3.8-flash and gemini-flash-lite-latest).
GEMINI_API_KEY=
GEMINI_MODEL=

# Meetings: audio and video calls inside the app (lib/daily.ts). Create a free account at daily.co,
# then Developers → API key. Without it, meetings still work with a Google Meet / Zoom link pasted in.
DAILY_API_KEY=

# Instagram analysis (owner and admins, lib/ig-analyzer): reads any public account through Apify.
# apify.com → Settings → API & Integrations → Personal API token. IG_POSTS_LIMIT: posts read per account (12–200, 50 by default).
APIFY_TOKEN=
IG_POSTS_LIMIT=

# Public sign-up (lib/signup.ts): 'on' lets any company create its own account and workspace, confirmed
# by an e-mailed code (needs GMAIL_* in production). Off by default.
PUBLIC_SIGNUP=
