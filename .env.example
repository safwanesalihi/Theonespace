# Server-only values. Copy to .env locally; never use a NEXT_PUBLIC_ prefix.

# The exact origin the browser uses (sessions are only issued for it).
AUTH_URL=http://127.0.0.1:5173

# The one owner account. Created on first sign-in with this password; change it in the app afterwards.
OWNER_EMAIL=contact@the1core.com
OWNER_PASSWORD=

# Invitations are e-mailed from this Gmail address using a Google "App password"
# (Google account → Security → 2-Step Verification → App passwords). Leave empty to hand the
# temporary password over yourself: it is then shown on the Team page.
GMAIL_USER=contact@the1core.com
GMAIL_APP_PASSWORD=

# For many agencies, a sending provider instead of Gmail (Gmail caps an account at a few hundred e-mails a
# day): any SMTP service — Resend, Postmark, Brevo, Amazon SES. When all four are set they are used instead
# of Gmail. MAIL_FROM is an address on a domain verified with the provider (SPF and DKIM records).
# Each agency's e-mails go out under its name, with its owner's address as Reply-To.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=

# Supabase Postgres. Leave DATABASE_URL empty locally to use the embedded Postgres in .data/pglite.
# DATABASE_URL: the *transaction* pooler (port 6543) — what the app uses at runtime.
# DIRECT_URL:   the session pooler / direct connection (port 5432) — what `pnpm db:migrate` uses.
DATABASE_URL=
DIRECT_URL=

# Vercel Cron calls /api/flow/sweep with this bearer token (32+ chars). Vercel injects it when set in the project.
CRON_SECRET=

# Plan éditorial → Facebook & Instagram (README → "Publication"). The scheduled run
# /api/editorial/publish-due uses CRON_SECRET above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=editorial-media
META_PUBLISH_TOKEN=
META_STUDIO_FACEBOOK_PAGE_ID=
META_STUDIO_INSTAGRAM_ID=
# Meta Graph API version for every Meta call (lib/meta-graph.ts). Empty: v21.0. Move it on once publishing, stats, sign-in and WhatsApp are checked.
META_GRAPH_VERSION=

# WhatsApp Business (Meta Cloud API): a client with a WhatsApp number gets a message each time a
# deliverable is sent for their approval. Leave empty to disable. The template must be approved in
# WhatsApp Manager first — see README → "WhatsApp" for the exact text.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
# Exact approved language code. Leave empty for automatic lookup.
WHATSAPP_TEMPLATE_LANGUAGE=
# Assignment template: member, task, assigner, sign-in URL (four body variables).
WHATSAPP_ASSIGNMENT_TEMPLATE=
WHATSAPP_ASSIGNMENT_LANGUAGE=
WHATSAPP_CHANGES_TEMPLATE=
WHATSAPP_CHANGES_LANGUAGE=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_REMINDER_LANGUAGE=
# The owner and the admins (with a WhatsApp number in Équipe) hear when a client approves a task.
# Template body: {{1}} person · {{2}} task · {{3}} client · {{4}} sign-in URL
WHATSAPP_APPROVED_TEMPLATE=
WHATSAPP_APPROVED_LANGUAGE=
# Optional: the « new message » template — the client hears on WhatsApp when the studio writes in a task's chat.
WHATSAPP_COMMENT_TEMPLATE=
WHATSAPP_COMMENT_LANGUAGE=

# AI with Groq (captions, titles, corrections, the floating assistant): a key from console.groq.com →
# API Keys. Optional if Gemini is configured below; both empty hides the AI buttons and assistant.
GROQ_API_KEY=
# Optional: other Groq models (text, and the one that reads pictures).
GROQ_MODEL=
GROQ_VISION_MODEL=
# Google Gemini (aistudio.google.com → API keys): the assistant, image/video/audio analysis before
# caption generation, and writing help without Groq. Required for reading the actual video (not a thumbnail).
# Optional model override (default gemini-flash-latest, then gemini-3.8-flash and gemini-flash-lite-latest).
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: how long Gemini thinks before answering — minimal, low (default, fast), medium, high.
GEMINI_THINKING=

# Meetings: audio and video calls inside the app (lib/daily.ts). Create a free account at daily.co,
# then Developers → API key. Without it, meetings still work with a Google Meet / Zoom link pasted in.
DAILY_API_KEY=

# Instagram analysis (owner and admins, lib/ig-analyzer): reads any public account through Apify.
# apify.com → Settings → API & Integrations → Personal API token. IG_POSTS_LIMIT: posts read per account (12–200, 50 by default).
APIFY_TOKEN=
IG_POSTS_LIMIT=

# Public sign-up (lib/signup.ts): 'on' lets any company create its own account and workspace, confirmed
# by an e-mailed code (needs GMAIL_* in production). Off by default.
PUBLIC_SIGNUP=

# Agency Google Drive. Optional dedicated web OAuth pair; leave both empty to reuse
# GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET, or AUTH_GOOGLE_ID + AUTH_GOOGLE_SECRET.
# Add the Drive callback to that existing web client. Consent/tokens stay separate.
# Enable Google Drive API + Google Picker API. Callback: AUTH_URL/api/drive/callback.
# Detailed setup and permissions: docs/GOOGLE-DRIVE-SETUP.md.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_PICKER_KEY=
GOOGLE_DRIVE_PROJECT_NUMBER=
# Use the existing AUTH_SECRET (32+ characters). It encrypts connected accounts and signs links and states:
# to change it, keep the old value in AUTH_SECRET_PREVIOUS (encrypted tokens only; signed links/states are re-issued).
AUTH_SECRET=
# Rotation: put the old AUTH_SECRET value(s) here (comma-separated) while moving to a new AUTH_SECRET;
# stored tokens are read with either, and re-encrypted with the new one when they are next saved.
AUTH_SECRET_PREVIOUS=
# Set to 1 ONLY when the app sits behind a reverse proxy that overwrites x-real-ip / x-forwarded-for.
# Vercel is detected through x-vercel-forwarded-for; without this flag other callers share one throttle bucket.
TRUST_PROXY_HEADERS=
